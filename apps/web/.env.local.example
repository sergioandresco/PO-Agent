# Clerk — the publishable key is embedded in the browser bundle by design.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Clerk routing. Required because the static export has no proxy/middleware to
# infer these from, and both pages use hash routing.
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/dashboard
NEXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/dashboard

# API Gateway base URL. Baked into the bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001
