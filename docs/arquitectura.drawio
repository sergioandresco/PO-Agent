        <mxCell id="n_iso" value="&lt;b&gt;Aislamiento por usuario (§8).&lt;/b&gt; La partition key del job es &lt;i&gt;USER#{userId}&lt;/i&gt;, así que un userId equivocado no puede alcanzar la fila de otro. Los artefactos son items separados: un backlog completo excede el límite de 400 KB por item, y editar una historia obligaría a reescribir el resultado entero." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#5A6472;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="950" y="770" width="420" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="n_retry" value="&lt;b&gt;El worker no reintenta.&lt;/b&gt; Un fallo del pipeline queda registrado en el job y el mensaje se borra: cada reintento automático sería otra ronda de llamadas pagadas al LLM sobre una transcripción que va a fallar igual. Solo los mensajes que ni llegan al pipeline van a la DLQ." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#5A6472;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="265" y="860" width="570" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="n_f2" value="Map sobre los segmentos, con reintentos por etapa, esquivando el techo de 15 min de Lambda (CLAUDE.md §3.1a).&lt;br/&gt;La cola, la tabla, el bucket y la API se reutilizan sin cambios." style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#9397AB;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="480" y="1015" width="900" height="50" as="geometry"/>
        </mxCell>
        <mxCell id="n_title" value="&lt;b style=&quot;font-size:16px;color:#232F3E&quot;&gt;Agente PO — arquitectura desplegada&lt;/b&gt;&lt;div style=&quot;font-size:11px;color:#5A6472;margin-top:4px&quot;&gt;Transcripción de reunión → backlog trazable. Frontend estático + backend serverless. Fase 1.&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#5A6472;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="30" width="560" height="60" as="geometry"/>
        </mxCell>
        <mxCell id="n_legend" value="&lt;span style=&quot;color:#232F3E&quot;&gt;──&lt;/span&gt; flujo de datos &amp;nbsp;&amp;nbsp; &lt;span style=&quot;color:#5A6472&quot;&gt;- -&lt;/span&gt; credenciales y observabilidad" style="text;html=1;align=left;verticalAlign=top;fontSize=10;fontColor=#5A6472;spacing=2;" vertex="1" parent="1">
          <mxGeometry x="30" y="630" width="300" height="40" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
